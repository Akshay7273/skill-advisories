{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Akshay7273/skill-advisories/main/schema/policy.schema.json",
  "title": "skill-advisories policy",
  "description": "Repository-owned controls for agent artifact advisory checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": "1" },
    "failOn": {
      "enum": ["low", "medium", "high", "critical"],
      "default": "high"
    },
    "deniedEcosystems": {
      "type": "array",
      "uniqueItems": true,
      "default": [],
      "items": {
        "enum": [
          "claude-skill",
          "claude-plugin",
          "clawhub",
          "mcp-server",
          "npm",
          "pypi",
          "vscode-extension",
          "github-action"
        ]
      }
    },
    "requireHash": { "type": "boolean", "default": false },
    "warnings": {
      "enum": ["allow", "review", "block"],
      "default": "review"
    }
  }
}
