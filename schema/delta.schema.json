{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Akshay7273/skill-advisories/main/schema/delta.schema.json",
  "title": "skill-advisories feed delta",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "from", "to", "generated", "upserts", "removed"],
  "properties": {
    "schema_version": { "const": "1" },
    "from": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "to": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated": { "type": "string", "format": "date-time" },
    "upserts": {
      "type": "array",
      "items": { "$ref": "advisory.schema.json" }
    },
    "removed": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SKA-[0-9]{4}-[0-9]{4,}$" }
    }
  }
}
