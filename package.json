{
  "name": "@akshay7273/skill-advisories",
  "version": "0.8.1",
  "description": "Open advisory database for AI agent skills, plugins, and MCP servers — machine-readable threat data for the agent ecosystem.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "skill-advisories": "dist/cli.js",
    "skill-advisories-mcp": "dist/mcp-cli.js"
  },
  "main": "dist/lookup.js",
  "types": "dist/lookup.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lookup.d.ts",
      "import": "./dist/lookup.js"
    },
    "./intelligence": {
      "types": "./dist/intelligence.d.ts",
      "import": "./dist/intelligence.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "import": "./dist/policy.js"
    },
    "./delta": {
      "types": "./dist/delta.d.ts",
      "import": "./dist/delta.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "feed",
    "docs",
    "examples",
    "integrations"
  ],
  "scripts": {
    "validate": "tsx src/validate-cli.ts",
    "compile": "tsx src/compile-cli.ts",
    "compile:refresh": "tsx src/compile-cli.ts --refresh-generated",
    "site": "node scripts/build-site.mjs",
    "health:check": "npm run site && node scripts/check-health.mjs",
    "ops:check": "node scripts/check-runbooks.mjs",
    "references:check": "npm run build && node scripts/check-references.mjs",
    "integrations:check": "npm run build && node scripts/check-integrations.mjs",
    "adopters:check": "npm run build && node scripts/check-adopters.mjs",
    "metrics:collect": "npm run build && node scripts/collect-metrics.mjs",
    "metrics:check": "npm run build && node scripts/collect-metrics.mjs --check",
    "lock:check": "npm run build && node dist/cli.js lock --check integrations --lockfile integrations/skill-advisories.lock.json --strict",
    "rollback:check": "npm run build && node dist/cli.js rollback feed --history feed/history.json",
    "build": "tsc && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/action.js",
    "smoke": "node scripts/smoke-cli.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "benchmark:ci": "npm run build && node scripts/benchmark.mjs --identities 100000 --artifacts 250 --max-lookup-ms 5000 --max-scan-ms 30000 --max-false-positive-ms 15000",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akshay7273/skill-advisories.git"
  },
  "keywords": [
    "security",
    "advisories",
    "ai-agents",
    "claude",
    "agent-skills",
    "mcp",
    "supply-chain",
    "threat-intelligence"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
